# ==============================================================================
# atomURL Frontend Environment Variables
# ==============================================================================

# Backend API Endpoint
# In production: https://api-atomurl.gurujadhav.in
# In local development: defaults automatically to http://localhost:8080
VITE_API_BASE_URL=https://api-atomurl.gurujadhav.in

# Public-facing domain for generated shortened links
# In production: defaults automatically to window.location.origin (e.g. https://atomurl.gurujadhav.in)
# In local development: defaults automatically to http://localhost:8080 (backend redirect engine)
# Set this if using a dedicated custom short domain (e.g. https://atu.rl or https://guru.li)
# VITE_SHORT_URL_BASE=https://atomurl.gurujadhav.in
