# ==========================================
# atomURL - Environment Configuration Template
# Copy this file to .env and fill in your values
# ==========================================

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=atomuser
DB_PASSWORD=atompassword

# --- CacheCore (In-Memory TCP Cache Engine) ---
CACHECORE_DOMAIN=localhost
CACHECORE_PORT=6948

# --- Admin Emails (Comma-separated list) ---
ADMIN_EMAILS=admin@example.com,owner@example.com

# --- JWT Authentication ---
# 256-bit secret key (min 32 characters)
JWT_SECRET=your-secure-jwt-secret-key-must-be-at-least-32-chars

# --- Email Delivery (Brevo SMTP or Mailpit for local testing) ---
# For local development with Docker Mailpit:
# MAIL_HOST=localhost
# MAIL_PORT=1025
# MAIL_SMTP_AUTH=false
# MAIL_SMTP_STARTTLS=false

# For production / Brevo SMTP (300 free emails/day):
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-smtp-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-master-key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- GitHub OAuth 2.0 (Optional) ---
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/oauth/github/callback

# --- Google OAuth 2.0 (Optional) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/oauth/google/callback

# --- Frontend URLs & CORS ---
FRONTEND_REDIRECT_URL=http://localhost:3000/auth/callback
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend Client Environment (Vite) ---
# VITE_API_BASE_URL=http://localhost:8080
